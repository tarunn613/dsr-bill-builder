{
  "name": "dsr-bill-builder",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "DSR Bill Builder — build a DSR Schedule of Work and turn it into an RA Bill (local desktop/web app for government tendering).",
  "author": "Tarun-IITG",
  "main": "desktop/main.cjs",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "sync-db": "python export_dsr_json.py",
    "dev": "node dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.gov.etenderdelhi.dsrbillbuilder",
    "productName": "DSR Bill Builder",
    "directories": {
      "output": "desktop-dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.DS_Store",
          "!data/sessions/**",
          "!package-lock.json"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DSR-Bill-Builder-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DSR Bill Builder",
      "uninstallDisplayName": "DSR Bill Builder",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "DSR-Bill-Builder-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}